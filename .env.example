# CodeKB secret configuration template.
# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Chat provider (used by `codekb ask` and `codekb knowledge draft`)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: Ollama, vLLM, LM Studio, or a cloud API.
CODEKB_CHAT_BASE_URL=http://localhost:11434/v1
CODEKB_CHAT_MODEL=qwen3
# Ollama ignores the key value but the SDK requires the header to be present.
CODEKB_CHAT_API_KEY=ollama

# ---------------------------------------------------------------------------
# Embedding provider (used by `codekb index` for the semantic index)
# ---------------------------------------------------------------------------
# NOTE: changing the embedding model or its dimension changes the vector space.
# After changing anything below, you must re-embed: `codekb index . --reembed`.
CODEKB_EMBEDDING_BASE_URL=http://localhost:11434
CODEKB_EMBEDDING_MODEL=qwen3-embedding
CODEKB_EMBEDDING_API_KEY=ollama